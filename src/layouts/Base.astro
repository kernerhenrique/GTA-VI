---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { launch } from '../lib/data';
import { canonicalPath } from '../lib/seo';

interface Props { title: string; description: string; jsonLd?: unknown[]; noindex?: boolean }
const { title, description, jsonLd = [], noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://gta6-fan-br.example');
const canonical = new URL(canonicalPath(Astro.url.pathname), site).href;
const ogImage = new URL('/og.jpg', site).href;
const releaseMs = Date.parse(launch.releaseISO);
const windowMs = launch.launchAnimationSeconds * 1000;
const localDate = launch.localMidnightDate;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#0C0D1B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Leonida BR — fan site de GTA VI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jason e Lucia numa praia de Vice City ao pôr do sol — GTA VI, 19.11.2026" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <script is:inline define:vars={{ releaseMs, windowMs, localDate }}>
      // Define o estado do lançamento ANTES da pintura (sem flash, sem erro de hidratação).
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var sim = null;
        try {
          // ?agora=ISO simula outra data; a simulação continua ao trocar de página (sessionStorage)
          var q = new URLSearchParams(location.search);
          var raw = q.get('agora') || q.get('now');
          if (raw) {
            var t = Date.parse(raw);
            if (isFinite(t)) { sim = t; sessionStorage.setItem('vi-sim', JSON.stringify({ t: t, at: Date.now() })); }
          } else {
            var s = JSON.parse(sessionStorage.getItem('vi-sim') || 'null');
            if (s && isFinite(s.t) && isFinite(s.at)) sim = s.t + (Date.now() - s.at);
          }
        } catch (e) {}
        var off = sim !== null ? sim - Date.now() : 0;
        var target = releaseMs;
        try {
          if (localStorage.getItem('vi-target') === 'local') {
            var p = localDate.split('-');
            target = new Date(+p[0], +p[1] - 1, +p[2], 0, 0, 0, 0).getTime();
          }
        } catch (e) {}
        window.__vi = { offset: off, simulated: sim !== null, target: target, releaseMs: releaseMs, windowMs: windowMs, localDate: localDate };
        var delta = Date.now() + off - target;
        d.dataset.launch = delta < 0 ? 'pre' : delta < windowMs ? 'launching' : 'live';
        if (sim !== null) d.dataset.sim = '1';
      })();
    </script>
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <div class="top-sentinel" aria-hidden="true" data-top-sentinel></div>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="sky" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="sim-banner" data-sim-banner hidden>
      <span role="status" data-sim-text></span>
      <button type="button" class="sim-exit" data-sim-exit>Sair da simulação</button>
    </div>
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/global.ts';
    </script>
  </body>
</html>

<style is:global>
  .top-sentinel { position: absolute; top: 0; left: 0; width: 1px; height: 24px; pointer-events: none; }
  .sim-banner {
    position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 70;
    background: var(--color-vi-cream); color: var(--color-vi-plum-deep);
    font: 700 .78rem/1.2 var(--font-mono); letter-spacing: .06em; padding: .6rem 1rem; border-radius: 999px;
    box-shadow: 0 10px 40px rgb(0 0 0 / .4); max-width: calc(100% - 24px); text-align: center;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px 12px;
  }
  .sim-banner[hidden] { display: none; }
  .sim-exit {
    font: inherit; color: var(--color-vi-cream); background: var(--color-vi-plum-deep); border: 0; border-radius: 999px;
    padding: .35rem .75rem; cursor: pointer; min-height: 32px;
  }
</style>
