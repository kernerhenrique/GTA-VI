---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { launch, story, editions, trailers, ratings } from '../lib/data';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const site = Astro.site ?? new URL('https://gta6-fan-br.example');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.jpg', site).href;
const releaseMs = Date.parse(launch.releaseISO);
const windowMs = launch.launchAnimationSeconds * 1000;
const localDate = launch.localMidnightDate;
const launchTrailer = trailers.items.find((t) => t.id === 'launch');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: launch.gameTitle,
  alternateName: ['GTA VI', 'GTA 6'],
  description: story.synopsis,
  url: canonical,
  sameAs: ['https://www.rockstargames.com/VI'],
  image: ogImage,
  datePublished: '2026-11-19',
  gamePlatform: launch.platforms,
  applicationCategory: 'Game',
  genre: ['Ação', 'Aventura', 'Mundo aberto'],
  playMode: 'SinglePlayer',
  publisher: { '@type': 'Organization', name: 'Rockstar Games', url: 'https://www.rockstargames.com' },
  author: { '@type': 'Organization', name: 'Rockstar Games' },
  contentRating: `ClassInd ${ratings.ratings.find((r) => r.id === 'classind')?.rating ?? '18'}`,
  offers: editions.editions.map((e) => ({ '@type': 'Offer', name: e.name, price: e.priceBRL.toFixed(2), priceCurrency: 'BRL', url: 'https://store.playstation.com/pt-br/concept/10000730', seller: { '@type': 'Organization', name: 'PlayStation Store Brasil' } })),
  trailer: launchTrailer && {
    '@type': 'VideoObject',
    name: `Grand Theft Auto VI — ${launchTrailer.title}`,
    description: launchTrailer.description,
    uploadDate: launchTrailer.date,
    thumbnailUrl: `https://i.ytimg.com/vi/${launchTrailer.youtubeId}/maxresdefault.jpg`,
    embedUrl: `https://www.youtube-nocookie.com/embed/${launchTrailer.youtubeId}`,
  },
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0C0D1B" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Leonida BR — fan site de GTA VI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jason e Lucia numa praia de Vice City ao pôr do sol — GTA VI, 19.11.2026" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <script is:inline define:vars={{ releaseMs, windowMs, localDate }}>
      // Define o estado do lançamento ANTES da pintura (sem flash, sem erro de hidratação).
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var sim = null;
        try {
          var q = new URLSearchParams(location.search);
          var raw = q.get('agora') || q.get('now');
          if (raw) { var t = Date.parse(raw); if (isFinite(t)) sim = t; }
        } catch (e) {}
        var off = sim !== null ? sim - Date.now() : 0;
        var target = releaseMs;
        try {
          if (localStorage.getItem('vi-target') === 'local') {
            var p = localDate.split('-');
            target = new Date(+p[0], +p[1] - 1, +p[2], 0, 0, 0, 0).getTime();
          }
        } catch (e) {}
        window.__vi = { offset: off, simulated: sim !== null, target: target, releaseMs: releaseMs, windowMs: windowMs, localDate: localDate };
        var delta = Date.now() + off - target;
        d.dataset.launch = delta < 0 ? 'pre' : delta < windowMs ? 'launching' : 'live';
        if (sim !== null) d.dataset.sim = '1';
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="sky" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="sim-banner" data-sim-banner hidden role="status"></div>
    <Header />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/global.ts';
    </script>
  </body>
</html>

<style is:global>
  .sim-banner {
    position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 70;
    background: var(--color-vi-cream); color: var(--color-vi-plum-deep);
    font: 700 .78rem/1.2 var(--font-mono); letter-spacing: .06em; padding: .6rem 1rem; border-radius: 999px;
    box-shadow: 0 10px 40px rgb(0 0 0 / .4); max-width: calc(100% - 24px); text-align: center;
  }
</style>
