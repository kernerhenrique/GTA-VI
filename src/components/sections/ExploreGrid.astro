---
/**
 * Mosaico "Explore" da home: um card grande com imagem para cada página.
 * Os ganchos (preço, contagens, nota) são calculados dos JSON — nada é digitado à mão aqui.
 */
import Picture from '../ui/Picture.astro';
import { pages, pageHref, editions, characters, regions, music, trailers, timeline, reviews, trivia, faq } from '../../lib/data';
import { formatBRL } from '../../lib/time';

const minPrice = Math.min(...editions.editions.map((e) => e.priceBRL));
const years = timeline.events.map((e) => e.date.slice(0, 4)).sort();
const scored = reviews.aggregates.filter((a) => a.score !== null);
const hooks: Record<string, string> = {
  comprar: `a partir de ${formatBRL(minPrice)}`,
  historia: `${characters.items.length} personagens`,
  leonida: `${regions.items.length} regiões`,
  jogabilidade: `${music.stations.length} rádios detalhadas`,
  trailers: `${trailers.items.length} trailers oficiais`,
  'linha-do-tempo': `${timeline.events.length} marcos · ${years[0]} → ${years[years.length - 1]}`,
  recepcao: scored.length ? scored.map((a) => `${a.name} ${a.score}`).join(' · ') : 'Notas: aguardando',
  extras: `${trivia.items.length} curiosidades`,
  faq: `${faq.items.length} perguntas`,
};
const cards = pages.filter((p) => p.slug in hooks);
---
<section id="explore" class="section explore" aria-labelledby="explore-title">
  <div class="container-vi">
    <header class="ex-head reveal">
      <p class="eyebrow">Guia do site</p>
      <h2 id="explore-title" class="section-title">Explore Leonida</h2>
      <p class="lead muted">Cada parte do jogo tem a sua página — com selo de veracidade e fonte em todo dado.</p>
    </header>
    <ul class="ex-grid" role="list">
      {cards.map((p, i) => (
        <li class={`ex-item ex-${p.slug} reveal`} style={`transition-delay:${(i % 3) * 70}ms`}>
          <a class="ex-card" href={pageHref(p.slug)} data-astro-prefetch data-tilt>
            <Picture name={p.cardImage} sizes={i < 2 ? '(min-width: 1024px) 680px, 100vw' : '(min-width: 1024px) 420px, (min-width: 560px) 50vw, 100vw'} decorative position={p.cardPosition} class="ex-pic" />
            <span class="ex-scrim" aria-hidden="true"></span>
            <span class="ex-num" aria-hidden="true">{String(pages.indexOf(p) + 1).padStart(2, '0')}</span>
            <span class="ex-body">
              <span class="ex-hook">{hooks[p.slug]}</span>
              <span class="ex-title">{p.label}</span>
              <span class="ex-lead">{p.lead}</span>
            </span>
            <span class="ex-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ex-head { max-width: 60ch; margin-bottom: clamp(1.8rem, 1.4rem + 2vw, 3rem); }
  .ex-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: 1fr; }
  .ex-item { display: flex; }
  .ex-card {
    position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end;
    width: 100%; min-height: 240px; border-radius: 22px; text-decoration: none; color: var(--color-vi-mist);
    border: 1px solid var(--vi-line); transition: border-color .35s, box-shadow .35s, transform .4s var(--ease-out-expo);
  }
  .ex-card :global(.ex-pic) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; aspect-ratio: auto !important; }
  .ex-card :global(.ex-pic img) { transition: transform .9s var(--ease-out-expo); }
  .ex-scrim { position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(12 13 27 / .95) 8%, rgb(12 13 27 / .55) 48%, rgb(12 13 27 / .1) 100%); transition: background .35s; }
  .ex-card:hover, .ex-card:focus-visible { border-color: rgb(233 99 155 / .6); box-shadow: 0 30px 70px -30px var(--vi-pink-glow); color: var(--color-vi-mist); }
  .ex-card:hover :global(.ex-pic img), .ex-card:focus-visible :global(.ex-pic img) { transform: scale(1.06); }
  .ex-num { position: absolute; top: 16px; left: 16px; font: 700 .72rem/1 var(--font-mono); letter-spacing: .12em; color: var(--color-vi-night); background: var(--color-vi-cream); padding: 5px 8px; border-radius: 999px; }
  .ex-body { display: grid; gap: 8px; padding: 22px 64px 22px 22px; }
  .ex-hook {
    justify-self: start; font: 700 .7rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase;
    color: var(--color-vi-night); background: var(--vi-sunset); padding: 6px 10px; border-radius: 999px; white-space: nowrap;
  }
  .ex-title { font: 900 clamp(1.9rem, 1.4rem + 2vw, 2.6rem)/.9 var(--font-display); text-transform: uppercase; color: var(--color-vi-cream); text-wrap: balance; }
  .ex-lead { font-size: .9rem; line-height: 1.45; color: rgb(226 226 228 / .8); max-width: 46ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .ex-arrow {
    position: absolute; right: 18px; bottom: 20px; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid rgb(255 249 203 / .35); color: var(--color-vi-cream); font-size: 1.2rem; transition: transform .35s var(--ease-out-expo), background .35s, color .35s;
  }
  .ex-card:hover .ex-arrow, .ex-card:focus-visible .ex-arrow { transform: translateX(4px); background: var(--color-vi-cream); color: var(--color-vi-night); }

  @media (min-width: 560px) {
    .ex-grid { grid-template-columns: 1fr 1fr; }
    .ex-comprar, .ex-historia { grid-column: 1 / -1; }
    .ex-comprar .ex-card, .ex-historia .ex-card { min-height: 320px; }
  }
  @media (min-width: 1024px) {
    .ex-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: 220px; gap: 16px;
      grid-template-areas:
        "c c c c c c c h h h h h"
        "c c c c c c c l l l l l"
        "j j j j t t t t r r r r"
        "w w w w x x x x x f f f";
    }
    .ex-comprar { grid-area: c; } .ex-historia { grid-area: h; } .ex-leonida { grid-area: l; }
    .ex-jogabilidade { grid-area: j; } .ex-trailers { grid-area: t; } .ex-linha-do-tempo { grid-area: r; }
    .ex-recepcao { grid-area: w; } .ex-extras { grid-area: x; } .ex-faq { grid-area: f; }
    .ex-card, .ex-comprar .ex-card, .ex-historia .ex-card { min-height: 0; }
    .ex-comprar .ex-title { font-size: clamp(2.6rem, 1.6rem + 3vw, 4.2rem); }
    .ex-comprar .ex-lead { -webkit-line-clamp: 3; font-size: 1rem; }
    .ex-faq .ex-lead, .ex-extras .ex-lead, .ex-trailers .ex-lead { display: none; }
  }
</style>
