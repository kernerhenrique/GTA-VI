---
import SectionHeader from '../ui/SectionHeader.astro';
import Badge from '../ui/Badge.astro';
import SourceRefs from '../ui/SourceRefs.astro';
import { trivia } from '../../lib/data';
---
<section id="curiosidades" class="section cv-auto trivia" aria-labelledby="curiosidades-title">
  <canvas class="halftone" data-halftone aria-hidden="true"></canvas>
  <div class="container-vi">
    <SectionHeader id="curiosidades-title" eyebrow="Para os detalhistas" title="Curiosidades e easter eggs" />
    <ul class="tv" role="list">
      {trivia.items.map((t, i) => (
        <li class="tv-item card card-hover reveal" style={`transition-delay:${(i % 3) * 60}ms`}>
          <span class="tv-n display" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="tv-title">{t.title}</h3>
          <p class="tv-text">{t.text}</p>
          <div class="flex flex-wrap gap-2 items-center mt-auto"><Badge status={t.status} /><SourceRefs ids={t.sources} /></div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trivia { isolation: isolate; overflow: hidden; }
  .halftone { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: .5; pointer-events: none;
    -webkit-mask-image: radial-gradient(80% 70% at 50% 40%, #000, transparent); mask-image: radial-gradient(80% 70% at 50% 40%, #000, transparent); }
  .tv { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .tv-item { padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .tv-n { font-size: 2.4rem; color: var(--color-vi-pink); }
  .tv-title { font: 900 1.4rem/1 var(--font-display); text-transform: uppercase; color: var(--color-vi-cream); margin: 0; }
  .tv-text { margin: 0; font-size: .92rem; }
</style>

<script>
  import { reducedMotion, whenVisible } from '../../scripts/clock';
  const c = document.querySelector<HTMLCanvasElement>('[data-halftone]');
  if (c) whenVisible(c, () => import('../../scripts/halftone').then((m) => m.startHalftone(c, reducedMotion())));
</script>
