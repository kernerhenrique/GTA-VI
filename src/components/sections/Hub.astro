---
import SplitFlap from '../hub/SplitFlap.astro';
import Badge from '../ui/Badge.astro';
import SourceRefs from '../ui/SourceRefs.astro';
import { launch, status, reviews } from '../../lib/data';
import { formatDateTime } from '../../lib/time';

const releaseMs = Date.parse(launch.releaseISO);
const brLabel = formatDateTime(releaseMs, launch.releaseTimeZone, { weekday: 'long' });
const cloudLabel = formatDateTime(Date.parse(launch.cloud.iso), launch.releaseTimeZone, { day: undefined, month: undefined, year: undefined });
const stateLabel: Record<string, string> = { ok: 'OK', pending: 'Aguardando', warn: 'Atenção', live: 'Ao vivo' };
---
<section id="hub" class="section hub" aria-labelledby="hub-title">
  <div class="container-vi hub-inner">
    <header class="hub-head reveal">
      <p class="eyebrow">Hub de lançamento</p>
      <h2 id="hub-title" class="section-title">
        <span data-show-when="pre">Contagem para Leonida</span>
        <span data-show-when="launching">Liberando…</span>
        <span data-show-when="live">Disponível agora</span>
      </h2>
      <p class="lead muted" data-show-when="pre">
        GTA VI libera à <strong class="text-vi-cream">meia-noite no horário local</strong> de cada região.
        No Brasil: <strong class="text-vi-cream">{brLabel}</strong> (horário de Brasília).
      </p>
      <p class="lead muted" data-show-when="launching live">
        Leonida está aberta. GTA VI foi liberado em <strong class="text-vi-cream">{brLabel}</strong> (horário de Brasília).
      </p>
    </header>

    <div class="hub-board reveal">
      <canvas class="terrain" data-terrain aria-hidden="true"></canvas>
      <SplitFlap />
      <p class="sr-only" role="status" aria-live="polite" data-countdown-sr>Lançamento em {brLabel}, horário de Brasília.</p>
      <noscript><p class="lead">Lançamento: {brLabel} (horário de Brasília).</p></noscript>
    </div>

    <div class="hub-times surface reveal">
      <div class="time-row">
        <span class="time-k">Brasil (Brasília)</span>
        <span class="time-v">{brLabel}</span>
      </div>
      <div class="time-row" data-local-row>
        <span class="time-k">Seu horário (<span data-local-tz>detectando…</span>)</span>
        <span class="time-v" data-local-time>—</span>
      </div>
      <div class="time-row">
        <span class="time-k">Xbox Cloud Gaming</span>
        <span class="time-v">19/11 às {cloudLabel} (Brasília)</span>
      </div>
      <fieldset class="target-toggle" data-target-toggle>
        <legend class="time-k">Contar até</legend>
        <label><input type="radio" name="vi-target" value="brasil" checked /> 0h de Brasília</label>
        <label><input type="radio" name="vi-target" value="local" /> meia-noite no meu fuso</label>
      </fieldset>
      <p class="time-note">
        <Badge status="confirmado" /> "Grand Theft Auto VI will release midnight local time on November 19, 2026, in all regions" — PS5 e Xbox Series X|S.
        Nos EUA, as lojas usam o horário ET para o país todo (<Badge status="reportado" scramble={false} />).
      </p>
      <SourceRefs ids={[...launch.sources, 'forbes-times']} />
    </div>

    <!-- Estado DISPONÍVEL AGORA -->
    <div class="live surface" data-show-when="live launching" data-live>
      <div class="live-head">
        <p class="eyebrow">Tempo desde o lançamento</p>
        <p class="live-since tabular" data-since>—</p>
      </div>
      <div class="live-stores">
        {launch.stores.map((s) => (
          <a class="btn btn-pill" href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>
        ))}
      </div>
      <div class="live-scores">
        {reviews.aggregates.map((a) => (
          <a class="score-tile" href={a.url} target="_blank" rel="noopener noreferrer">
            <span class="score-k">{a.name}</span>
            {a.score !== null
              ? <span class="score-v tabular" data-count-to={a.score}>{a.score}</span>
              : <span class="score-v score-wait">Aguardando</span>}
            <span class="score-n">{a.score !== null ? `${a.count ?? ''} reviews` : 'aguardando reviews'}</span>
          </a>
        ))}
      </div>
      <p class="muted text-sm">
        <a href={launch.officialDownloads.url} target="_blank" rel="noopener noreferrer">{launch.officialDownloads.label} ↗</a>
      </p>
    </div>

    <!-- Painel de status -->
    <div class="status-grid" role="list" aria-label="Status do lançamento">
      {status.items.map((it) => (
        <article class={`status card reveal status--${it.state}`} role="listitem">
          <div class="status-top">
            <span class="status-label">{it.label}</span>
            <span class={`status-pill status-pill--${it.state}`}>{stateLabel[it.state]}</span>
          </div>
          <p class="status-value">{it.value}</p>
          <p class="status-detail">{it.detail}</p>
          <div class="status-foot"><Badge status={it.status} /><SourceRefs ids={it.sources} /></div>
        </article>
      ))}
    </div>
  </div>

  <!-- Transição Dot Wipe no T-0 -->
  <div class="dot-wipe" data-dot-wipe aria-hidden="true">
    <span class="dot-wipe-dot"></span>
    <span class="dot-wipe-word display">Liberado<span class="text-vi-cream">.</span></span>
  </div>
</section>

<style>
  .hub { overflow: hidden; isolation: isolate; }
  .terrain { position: absolute; left: 50%; top: -38%; width: 100vw; height: 176%; transform: translateX(-50%); z-index: -1; opacity: .6; pointer-events: none; display: none;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 18%, #000 80%, transparent); mask-image: linear-gradient(180deg, transparent, #000 18%, #000 80%, transparent); }
  @media (min-width: 1024px) { .terrain { display: block; } }
  .hub-inner { display: grid; gap: clamp(20px, 3vw, 32px); }
  .hub-head { max-width: 62ch; }
  .hub-board { position: relative; display: flex; justify-content: center; isolation: isolate; }
  .hub-times { padding: clamp(16px, 3vw, 28px); display: grid; gap: 12px; }
  .time-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; padding-bottom: 10px; border-bottom: 1px solid rgb(204 194 245 / .1); }
  .time-k { font: 600 .72rem/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: rgb(226 226 228 / .7); }
  .time-v { font-weight: 700; color: var(--color-vi-cream); }
  .time-v::first-letter { text-transform: uppercase; }
  .target-toggle { border: 0; padding: 0; margin: 4px 0 0; display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; }
  .target-toggle legend { float: left; margin-right: 8px; }
  .target-toggle label { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--vi-line); cursor: pointer; font-size: .9rem; }
  .target-toggle label:has(input:checked) { background: var(--color-vi-blush); color: var(--color-vi-plum-deep); border-color: transparent; font-weight: 700; }
  .target-toggle input { accent-color: var(--color-vi-pink); }
  .time-note { font-size: .82rem; color: rgb(226 226 228 / .78); margin: 4px 0 0; }

  .live { padding: clamp(18px, 3vw, 32px); display: grid; gap: 18px; border-color: rgb(233 99 155 / .5); box-shadow: 0 30px 80px -40px var(--vi-pink-glow); }
  .live-since { font: 700 clamp(1.8rem, 1rem + 4vw, 3.6rem)/1 var(--font-mono); color: var(--color-vi-cream); margin: .3rem 0 0; }
  .live-stores { display: flex; flex-wrap: wrap; gap: 10px; }
  .live-scores { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; }
  .score-tile { display: grid; gap: 4px; padding: 14px 16px; border-radius: 16px; border: 1px solid var(--vi-line); text-decoration: none; color: inherit; background: rgb(12 13 27 / .6); }
  .score-k { font: 600 .72rem/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--color-vi-peach); }
  .score-v { font: 900 3rem/1 var(--font-display); color: var(--color-vi-cream); }
  .score-wait { color: rgb(226 226 228 / .45); font-size: 1.8rem; }
  .score-n { font-size: .78rem; color: rgb(226 226 228 / .65); }

  .status-grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); }
  .status { padding: 16px 16px 14px; display: flex; flex-direction: column; gap: 6px; }
  .status-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .status-label { font: 600 .7rem/1 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; color: rgb(226 226 228 / .7); }
  .status-pill { font: 700 .62rem/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; padding: 5px 8px; border-radius: 999px; }
  .status-pill--ok { background: rgb(204 194 245 / .14); color: var(--color-vi-lavender); }
  .status-pill--pending { background: rgb(254 196 151 / .14); color: var(--color-vi-peach); }
  .status-pill--warn { background: rgb(233 99 155 / .16); color: var(--color-vi-blush); }
  .status-pill--live { background: var(--color-vi-pink); color: var(--color-vi-night); }
  .status-value { font: 800 1.45rem/1.1 var(--font-display); text-transform: uppercase; color: var(--color-vi-cream); margin: 4px 0 0; letter-spacing: .01em; }
  .status-detail { font-size: .86rem; color: rgb(226 226 228 / .78); margin: 0; flex: 1; }
  .status-foot { display: flex; flex-direction: column; gap: 6px; margin-top: 6px; }
  .status-foot :global(.src-refs) { margin: 0; }

  .dot-wipe { position: absolute; inset: 0; z-index: 30; pointer-events: none; display: grid; place-items: center; visibility: hidden; }
  .dot-wipe-dot { position: absolute; left: 50%; top: 50%; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; background: var(--color-vi-pink); transform: scale(0); }
  .dot-wipe-word { position: relative; font-size: clamp(3.5rem, 2rem + 10vw, 11rem); color: var(--color-vi-night); clip-path: inset(0 0 100% 0); }
  .dot-wipe.is-on { visibility: visible; }
  .dot-wipe.is-on .dot-wipe-dot { animation: dot-grow 1.1s var(--ease-glide) forwards, dot-fade .6s ease 3.4s forwards; }
  .dot-wipe.is-on .dot-wipe-word { animation: word-up .8s var(--ease-out-expo) 1s forwards, dot-fade .6s ease 3.4s forwards; }
  @keyframes dot-grow { 0% { transform: scale(0); } 30% { transform: scale(1.6); } 100% { transform: scale(140); } }
  @keyframes word-up { from { clip-path: inset(0 0 100% 0); transform: translateY(30%); } to { clip-path: inset(0 0 0 0); transform: none; } }
  @keyframes dot-fade { to { opacity: 0; } }
</style>

<script>
  import { now, onTick, vi, getTargetMode, setTargetMode, reducedMotion, whenVisible } from '../../scripts/clock';
  import { timeUntil, timeSince, pad2 } from '../../lib/launch-state';
  import { createBoard } from '../../scripts/splitflap';

  const root = document.getElementById('hub')!;
  const board = createBoard(root.querySelector('[data-board]')!);
  const sr = root.querySelector<HTMLElement>('[data-countdown-sr]')!;
  const since = root.querySelector<HTMLElement>('[data-since]')!;
  const statusEl = root.querySelector<HTMLElement>('[data-board-status]')!;
  const wipe = root.querySelector<HTMLElement>('[data-dot-wipe]')!;

  // Fuso e horário local do visitante
  const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'local';
  root.querySelector('[data-local-tz]')!.textContent = tz.replace(/_/g, ' ');
  const localFmt = new Intl.DateTimeFormat('pt-BR', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  const renderLocal = () => {
    const mode = getTargetMode();
    const t = vi().target;
    const el = root.querySelector('[data-local-time]')!;
    el.textContent = localFmt.format(t) + (mode === 'local' ? ' (meia-noite local)' : '');
    statusEl.textContent = mode === 'local'
      ? `No horário · meia-noite no seu fuso (${tz.replace(/_/g, ' ')})`
      : 'No horário · 19/11 · 00:00 (Brasília)';
  };

  // Toggle "contar até"
  const toggle = root.querySelector<HTMLFieldSetElement>('[data-target-toggle]')!;
  toggle.querySelectorAll<HTMLInputElement>('input').forEach((inp) => {
    inp.checked = inp.value === getTargetMode();
    inp.addEventListener('change', () => { setTargetMode(inp.value as 'brasil' | 'local'); renderLocal(); lastMinute = -1; });
  });
  renderLocal();

  let lastMinute = -1;
  let launched = false;

  function playLaunch() {
    if (launched) return;
    launched = true;
    board.flipToWord('LIBERADO');
    statusEl.textContent = 'Embarque liberado · bem-vindo a Leonida';
    if (!reducedMotion()) {
      wipe.classList.add('is-on');
      setTimeout(() => wipe.classList.remove('is-on'), 4200);
    }
  }

  onTick((t) => {
    const state = document.documentElement.dataset.launch;
    const target = vi().target;
    if (state === 'pre') {
      launched = false;
      const p = timeUntil(t, target);
      board.setDigits(`${pad2(Math.min(99, p.days))}${pad2(p.hours)}${pad2(p.minutes)}${pad2(p.seconds)}`);
      if (p.minutes !== lastMinute) {
        lastMinute = p.minutes;
        sr.textContent = `Faltam ${p.days} dias, ${p.hours} horas e ${p.minutes} minutos para o lançamento.`;
      }
    } else if (state === 'launching') {
      playLaunch();
      sr.textContent = 'GTA VI foi liberado!';
    } else {
      if (!launched) { launched = true; board.setWord('LIBERADO'); statusEl.textContent = 'Embarque liberado · bem-vindo a Leonida'; }
      const s = timeSince(t, target);
      since.textContent = `${s.days}d ${pad2(s.hours)}h ${pad2(s.minutes)}m ${pad2(s.seconds)}s`;
    }
    if (state !== 'pre') {
      const s = timeSince(t, target);
      since.textContent = `${s.days}d ${pad2(s.hours)}h ${pad2(s.minutes)}m ${pad2(s.seconds)}s`;
    }
  });

  // Terrain Mesh (só desktop, fora do reduced motion, pausado fora da tela)
  const canvas = root.querySelector<HTMLCanvasElement>('[data-terrain]')!;
  if (matchMedia('(min-width: 1024px)').matches && !reducedMotion()) {
    whenVisible(canvas, () => import('../../scripts/terrain').then((m) => m.startTerrain(canvas, canvas)));
  }
  void now;
</script>
