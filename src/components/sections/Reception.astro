---
import SectionHeader from '../ui/SectionHeader.astro';
import Badge from '../ui/Badge.astro';
import SourceRefs from '../ui/SourceRefs.astro';
import LoopClip from '../ui/LoopClip.astro';
import { reviews, community } from '../../lib/data';
const updated = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short', timeZone: 'America/Sao_Paulo' }).format(Date.parse(reviews.updatedAt));
const hasScores = reviews.aggregates.some((a) => a.score !== null);
interface Props { headless?: boolean }
const { headless = false } = Astro.props;
---
<section id="recepcao" class={`section cv-auto${headless ? ' pt-tight' : ''}`} aria-labelledby={headless ? 'page-title' : 'recepcao-title'}>
  <div class="container-vi">
    {headless ? <h2 class="sr-only">Recepção</h2> : <SectionHeader id="recepcao-title" eyebrow="Crítica e comunidade" title="Recepção" lead={hasScores ? 'Notas agregadas, trechos das reviews e o que a comunidade está dizendo.' : 'As reviews ainda não saíram. Esta seção é atualizada assim que o embargo cair.'} />}

    <div class="rc-top">
      <div class="rc-scores">
        {reviews.aggregates.map((a) => (
          <a class="rc-score card card-hover reveal" href={a.url} target="_blank" rel="noopener noreferrer">
            <span class="eyebrow">{a.name}</span>
            {a.score !== null
              ? <span class="rc-big tabular"><span aria-hidden="true" data-count-to={a.score}>{a.score}</span><span class="sr-only">{a.score} de {a.max}</span><small>/{a.max}</small></span>
              : <span class="rc-big rc-wait">Aguardando</span>}
            <span class="text-sm muted">{a.score !== null ? `${a.count ?? '?'} reviews` : a.note}</span>
            <span class="flex flex-wrap gap-2 items-center"><Badge status={a.status} /></span>
          </a>
        ))}
      </div>
      <div class="rc-embargo card reveal">
        <p class="eyebrow">Embargo das reviews</p>
        <p class="rc-emb-text">{reviews.embargo.text}</p>
        <div class="flex flex-wrap gap-2 items-center"><Badge status={reviews.embargo.status} /><SourceRefs ids={reviews.embargo.sources} /></div>
        <p class="eyebrow mt-4">Referências da casa</p>
        <ul class="bench" role="list">
          {reviews.benchmarks.map((b) => (
            <li>
              <span class="bench-name">{b.game}</span>
              <span class="bench-bar" aria-hidden="true"><span style={`--v:${b.score}`}></span></span>
              <span class="bench-v tabular">{b.score}</span>
              <span class="sr-only">{b.label}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-2 items-center"><Badge status={reviews.benchmarksStatus} scramble={false} /><SourceRefs ids={reviews.benchmarksSources} /></div>
        <p class="text-xs muted mt-2">Última revisão desta seção: {updated} (Brasília).</p>
      </div>
    </div>

    <h3 class="rc-sub reveal">O que a crítica diz</h3>
    {reviews.quotes.length ? (
      <ul class="quotes" role="list">
        {reviews.quotes.map((q) => (
          <li class="quote card reveal">
            <p class="quote-text">“{q.text}”</p>
            <p class="quote-src"><a href={q.url} target="_blank" rel="noopener noreferrer">{q.outlet}</a>{q.score && <> · <strong>{q.score}</strong></>}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty card reveal">Nenhuma review publicada até {updated}. Quando o embargo cair, entram aqui trechos curtos (uma frase) de cada veículo, com link para a análise completa.</p>
    )}
    <div class="proscons">
      <div class="card pc reveal"><h4>Prós mais citados</h4>{reviews.pros.length ? <ul>{reviews.pros.map((p) => <li>{p}</li>)}</ul> : <p class="muted text-sm">Aguardando as reviews.</p>}</div>
      <div class="card pc reveal"><h4>Contras mais citados</h4>{reviews.cons.length ? <ul>{reviews.cons.map((p) => <li>{p}</li>)}</ul> : <p class="muted text-sm">Aguardando as reviews.</p>}</div>
    </div>

    <h3 class="rc-sub reveal">Jogadores, streamers e números</h3>
    <div class="community">
      {community.items.map((c) => (
        <article class="cm card reveal">
          {c.stat && <p class="cm-stat"><span class="tabular" aria-hidden="true" data-count-to={c.stat.value}>{c.stat.display}</span><span class="sr-only">{c.stat.display}</span><small>{c.stat.label}</small></p>}
          <h4 class="cm-title">{c.title}</h4>
          <p class="cm-text">{c.text}</p>
          <div class="flex flex-wrap gap-2 items-center mt-auto"><Badge status={c.status} /><SourceRefs ids={c.sources} /></div>
        </article>
      ))}
    </div>
  </div>
  <div class="rc-break reveal">
    <LoopClip clip="reception-break" fallback="break-jl-robbery" sizes="100vw" ratio="21/8" class="rc-break-pic" label="Clipe sem som de Jason e Lucia (GTA VI)" />
    <p class="credit container-vi">Arte oficial © Rockstar Games</p>
  </div>
</section>

<style>
  .rc-top { display: grid; gap: 16px; }
  @media (min-width: 1000px) { .rc-top { grid-template-columns: 1.1fr .9fr; } }
  .rc-scores { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .rc-score { padding: 20px; display: grid; gap: 8px; text-decoration: none; color: inherit; }
  .rc-big { font: 900 clamp(4rem, 3rem + 4vw, 6.5rem)/1 var(--font-display); color: var(--color-vi-cream); }
  .rc-big small { font-size: .35em; color: rgb(226 226 228 / .5); margin-left: 4px; }
  .rc-wait { color: rgb(226 226 228 / .45); font-size: clamp(2rem, 1.5rem + 1.5vw, 2.8rem); }
  .rc-embargo { padding: 20px; display: grid; gap: 10px; align-content: start; }
  .rc-embargo p { margin: 0; }
  .rc-emb-text { font-size: 1rem; color: var(--color-vi-cream); }
  .bench { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .bench li { display: grid; grid-template-columns: 9.5rem 1fr 2.5rem; gap: 10px; align-items: center; font-size: .86rem; }
  .bench-bar { height: 10px; border-radius: 999px; background: rgb(204 194 245 / .12); overflow: hidden; }
  .bench-bar span { display: block; height: 100%; width: calc((var(--v) - 80) * 5%); background: var(--vi-sunset); border-radius: inherit; }
  .bench-v { font: 800 1rem/1 var(--font-mono); color: var(--color-vi-cream); text-align: right; }
  .rc-sub { font: 900 clamp(1.8rem, 1.2rem + 2.4vw, 3rem)/.9 var(--font-display); text-transform: uppercase; color: var(--color-vi-cream); margin: clamp(2.5rem, 2rem + 2vw, 4rem) 0 1.25rem; }
  .quotes { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .quote { padding: 18px; }
  .quote-text { font: 700 1.1rem/1.35 var(--font-sans); color: var(--color-vi-cream); margin: 0 0 8px; }
  .quote-src { margin: 0; font: 600 .8rem/1 var(--font-mono); }
  .empty { padding: 18px 20px; margin: 0; border-style: dashed; color: rgb(226 226 228 / .8); }
  .proscons { display: grid; gap: 12px; margin-top: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .pc { padding: 18px 20px; }
  .pc h4 { font: 900 1.3rem/1 var(--font-display); text-transform: uppercase; color: var(--color-vi-cream); margin: 0 0 8px; }
  .community { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .cm { padding: 18px 20px; display: flex; flex-direction: column; gap: 8px; }
  .cm p { margin: 0; }
  .cm-stat { display: grid; }
  .cm-stat .tabular { font: 900 2.8rem/1 var(--font-display); background: var(--vi-sunset); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cm-stat small { font: 600 .7rem/1.3 var(--font-mono); text-transform: uppercase; letter-spacing: .1em; color: var(--color-vi-peach); }
  .cm-title { font: 900 1.3rem/1 var(--font-display); text-transform: uppercase; color: var(--color-vi-cream); margin: 0; }
  .cm-text { font-size: .9rem; }
  .rc-break { margin-top: clamp(3rem, 2rem + 4vw, 6rem); }
  .rc-break :global(.rc-break-pic) { width: 100%; max-height: 520px; mask-image: linear-gradient(180deg, transparent, #000 15%, #000 85%, transparent); -webkit-mask-image: linear-gradient(180deg, transparent, #000 15%, #000 85%, transparent); }
</style>
