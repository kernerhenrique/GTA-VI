---
/** Faixa-convite para apoiar o site (home e fim das páginas internas). Some se não houver chave Pix em support.json. */
import { support } from '../../lib/data';

interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const show = Boolean(support.pix.key);
---
{show && (
  <aside class:list={['band-support', 'container-vi', { 'is-compact': compact }]} aria-labelledby={compact ? undefined : 'support-band-title'} aria-label={compact ? 'Apoie o site' : undefined}>
    <div class="bs-inner">
      <span class="bs-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z" fill="currentColor" /></svg>
      </span>
      <div class="bs-text">
        {compact
          ? <p class="bs-title-sm">{support.headline}</p>
          : <h2 id="support-band-title" class="bs-title">{support.headline}</h2>}
        <p class="bs-copy">{support.bandText}</p>
      </div>
      <a class="bs-btn" href="/apoie" data-astro-prefetch>Apoiar com Pix <span aria-hidden="true">→</span></a>
    </div>
  </aside>
)}

<style>
  .band-support { margin-block: clamp(2rem, 1.5rem + 2vw, 4rem); }
  .is-compact { margin-block: 0 clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .bs-inner {
    position: relative; overflow: hidden; display: grid; gap: 18px; align-items: center;
    padding: clamp(22px, 3vw, 40px); border-radius: 24px; border: 1px solid rgb(233 99 155 / .45);
    background:
      radial-gradient(80% 140% at 100% 0%, rgb(233 99 155 / .3), transparent 60%),
      radial-gradient(60% 120% at 0% 100%, rgb(254 196 151 / .18), transparent 60%),
      rgb(17 17 23 / .92);
  }
  @media (min-width: 820px) { .bs-inner { grid-template-columns: auto 1fr auto; gap: 26px; } }
  .bs-icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; background: var(--vi-sunset); color: var(--color-vi-night); box-shadow: 0 12px 30px -10px var(--vi-pink-glow); }
  .bs-icon svg { width: 28px; height: 28px; }
  @media (prefers-reduced-motion: no-preference) { .bs-icon svg { animation: beat 2.4s ease-in-out infinite; } }
  @keyframes beat { 0%, 60%, 100% { transform: scale(1); } 10% { transform: scale(1.12); } 20% { transform: scale(.98); } 30% { transform: scale(1.08); } }
  .bs-title, .bs-title-sm { margin: 0 0 6px; font: 900 clamp(1.8rem, 1.2rem + 2.2vw, 3rem)/.92 var(--font-display); text-transform: uppercase; color: var(--color-vi-cream); }
  .bs-title-sm { font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2rem); }
  .bs-copy { margin: 0; max-width: 62ch; color: var(--color-vi-mist); line-height: 1.55; }
  .is-compact .bs-copy { font-size: .92rem; }
  .bs-btn {
    justify-self: start; display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 24px; border-radius: 999px; text-decoration: none; white-space: nowrap;
    background: var(--vi-sunset); color: var(--color-vi-night); font: 900 1.1rem/1 var(--font-display); text-transform: uppercase; letter-spacing: .06em;
    box-shadow: 0 14px 34px -12px var(--vi-pink-glow); transition: transform .2s;
  }
  .bs-btn:hover { color: var(--color-vi-night); transform: translateY(-2px); }
</style>
