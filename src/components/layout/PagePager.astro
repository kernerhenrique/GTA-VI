---
/** Navegação "anterior / próxima" no fim de cada página interna, na ordem de src/data/pages.json. */
import Picture from '../ui/Picture.astro';
import { chapters as pages, pageHref } from '../../lib/data';

interface Props { slug: string }
const { slug } = Astro.props;
const i = pages.findIndex((p) => p.slug === slug);
const prev = i > 0 ? pages[i - 1] : null;
const next = i < pages.length - 1 ? pages[i + 1] : null;
const links = [
  prev ? { dir: 'prev', label: 'Anterior', page: prev } : { dir: 'prev', label: 'Voltar', page: null },
  next ? { dir: 'next', label: 'Próxima', page: next } : null,
].filter((l): l is NonNullable<typeof l> => !!l);
---
<nav class="pager container-vi" aria-label="Continuar lendo">
  {links.map((l) => (
    <a class={`pager-card pager-${l.dir}`} href={l.page ? pageHref(l.page.slug) : '/'} data-astro-prefetch>
      <Picture name={l.page ? l.page.cardImage : 'hero-keyart'} sizes="(min-width: 900px) 560px, 100vw" ratio="21/9" decorative position={l.page?.cardPosition} class="pager-pic" />
      <span class="pager-scrim" aria-hidden="true"></span>
      <span class="pager-text">
        <span class="pager-dir">{l.dir === 'prev' ? '← ' : ''}{l.label}{l.dir === 'next' ? ' →' : ''}</span>
        <span class="pager-title">{l.page ? l.page.label : 'Início e contagem'}</span>
      </span>
    </a>
  ))}
</nav>

<style>
  .pager { display: grid; gap: 16px; padding-bottom: clamp(3rem, 2rem + 4vw, 6rem); }
  @media (min-width: 760px) { .pager { grid-template-columns: 1fr 1fr; } .pager-next:only-child { grid-column: 2; } }
  .pager-card {
    position: relative; display: block; overflow: hidden; border-radius: 22px; text-decoration: none;
    border: 1px solid var(--vi-line); isolation: isolate; transition: border-color .3s, box-shadow .3s;
  }
  .pager-card :global(.pager-pic) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; aspect-ratio: auto !important; }
  .pager-card :global(.pager-pic img) { transition: transform .8s var(--ease-out-expo); }
  .pager-card:hover { border-color: rgb(233 99 155 / .6); box-shadow: 0 24px 60px -24px var(--vi-pink-glow); }
  .pager-card:hover :global(.pager-pic img) { transform: scale(1.05); }
  .pager-scrim { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(12 13 27 / .92), rgb(12 13 27 / .45)); }
  .pager-next .pager-scrim { background: linear-gradient(270deg, rgb(12 13 27 / .92), rgb(12 13 27 / .45)); }
  .pager-text { display: grid; gap: 8px; padding: clamp(24px, 3vw, 36px); min-height: 150px; align-content: end; }
  .pager-next .pager-text { text-align: right; }
  .pager-dir { font: 600 .72rem/1 var(--font-mono); letter-spacing: .18em; text-transform: uppercase; color: var(--color-vi-peach); }
  .pager-title { font: 900 clamp(1.8rem, 1.2rem + 2vw, 2.8rem)/.9 var(--font-display); text-transform: uppercase; color: var(--color-vi-cream); }
</style>
