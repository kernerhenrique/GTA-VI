---
/** Menu do celular em tela cheia (<dialog> nativo: foco preso, Esc fecha, fundo inerte). */
import { pages, pageHref } from '../../lib/data';

interface Props { current: string }
const { current } = Astro.props;
const items = [{ slug: '', label: 'Início · contagem' }, ...pages.map((p) => ({ slug: p.slug, label: p.label }))];
---
<dialog id="mobile-menu" class="m-menu" aria-label="Menu do site" data-mobile-menu>
  <div class="m-inner">
    <div class="m-top">
      <span class="m-brand" aria-hidden="true"><span class="m-mark">VI</span><span>Leonida<span class="m-br">BR</span></span></span>
      <button type="button" class="m-close" data-menu-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <span>Fechar</span>
      </button>
    </div>

    <div class="m-actions">
      <a class="m-count" href="/#hub" data-mini-countdown>
        <span class="m-count-label" data-mini-label>Lança em</span>
        <span class="m-count-value tabular" data-mini-text>19.11.2026</span>
      </a>
      <a class="m-buy" href="/comprar" aria-current={current === '/comprar' ? 'page' : undefined}>Comprar</a>
    </div>

    <nav aria-label="Páginas">
      <ol class="m-list">
        {items.map((it, i) => (
          <li style={`--i:${i}`}>
            <a href={pageHref(it.slug)} aria-current={current === pageHref(it.slug) ? 'page' : undefined}>
              <span class="m-num" aria-hidden="true">{String(i).padStart(2, '0')}</span>
              <span class="m-label">{it.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <p class="m-foot">Fan site não oficial · imagens © Rockstar Games</p>
  </div>
</dialog>

<style>
  .m-menu {
    width: 100%; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0;
    background:
      radial-gradient(120% 60% at 100% 0%, rgb(233 99 155 / .22), transparent 60%),
      radial-gradient(90% 50% at 0% 100%, rgb(254 196 151 / .14), transparent 60%),
      var(--color-vi-night);
    color: var(--color-vi-mist);
  }
  .m-menu::backdrop { background: rgb(12 13 27 / .6); }
  :global(html.menu-open) { overflow: hidden; }
  .m-inner { min-height: 100%; display: flex; flex-direction: column; padding: 12px 16px calc(20px + env(safe-area-inset-bottom)); }
  .m-top { display: flex; align-items: center; justify-content: space-between; height: 52px; }
  .m-brand { display: inline-flex; align-items: center; gap: 10px; font: 900 1.4rem/1 var(--font-display); text-transform: uppercase; color: var(--color-vi-cream); }
  .m-mark { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: var(--vi-sunset); color: var(--color-vi-night); font-size: 1.2rem; }
  .m-br { color: var(--color-vi-pink); }
  .m-close {
    display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 14px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--vi-line); background: transparent; color: var(--color-vi-cream);
    font: 800 .95rem/1 var(--font-display); text-transform: uppercase; letter-spacing: .08em;
  }
  .m-close svg { width: 18px; height: 18px; }

  .m-actions { display: grid; grid-template-columns: 1fr auto; gap: 10px; margin: 14px 0 10px; }
  .m-count {
    display: flex; flex-direction: column; justify-content: center; gap: 4px; padding: 10px 16px; border-radius: 16px; text-decoration: none; color: var(--color-vi-cream);
    border: 1px solid transparent;
    background: linear-gradient(var(--color-vi-night), var(--color-vi-night)) padding-box, linear-gradient(90deg, var(--color-vi-peach), var(--color-vi-pink), var(--color-vi-lavender)) border-box;
  }
  .m-count-label { font: 600 .62rem/1 var(--font-mono); letter-spacing: .18em; text-transform: uppercase; color: var(--color-vi-peach); }
  .m-count-value { font: 700 1.05rem/1 var(--font-mono); }
  .m-buy {
    display: grid; place-items: center; padding: 0 22px; border-radius: 16px; text-decoration: none;
    background: var(--vi-sunset); color: var(--color-vi-night); font: 900 1.25rem/1 var(--font-display); text-transform: uppercase; letter-spacing: .06em;
  }
  .m-buy:hover { color: var(--color-vi-night); }

  .m-list { list-style: none; margin: 6px 0 0; padding: 0; }
  .m-list a {
    display: flex; align-items: baseline; gap: 14px; padding: 9px 2px; text-decoration: none; color: var(--color-vi-mist);
    border-bottom: 1px solid rgb(204 194 245 / .1);
  }
  .m-num { font: 600 .72rem/1 var(--font-mono); color: rgb(226 226 228 / .5); min-width: 1.6em; }
  .m-label { font: 900 clamp(1.5rem, 6.6vw, 2.1rem)/.95 var(--font-display); text-transform: uppercase; letter-spacing: .01em; }
  .m-list a:hover .m-label, .m-list a:focus-visible .m-label { color: var(--color-vi-cream); }
  .m-list a[aria-current="page"] .m-label { background: var(--vi-sunset); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .m-list a[aria-current="page"] .m-num { color: var(--color-vi-pink); }
  .m-foot { margin: auto 0 0; padding-top: 18px; font: 600 .62rem/1.4 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: rgb(226 226 228 / .5); }

  @media (prefers-reduced-motion: no-preference) {
    .m-menu[open] { animation: m-in .35s var(--ease-out-expo); }
    .m-menu[open] .m-list li { animation: m-item .5s var(--ease-out-expo) both; animation-delay: calc(var(--i) * 28ms + 60ms); }
  }
  @keyframes m-in { from { opacity: 0; clip-path: inset(0 0 100% 0); } to { opacity: 1; clip-path: inset(0 0 0 0); } }
  @keyframes m-item { from { opacity: 0; transform: translateX(-18px); } }
</style>
