---
interface Props { id: string; eyebrow: string; title: string; lead?: string; align?: 'left' | 'center' }
const { id, eyebrow, title, lead, align = 'left' } = Astro.props;
---
<header class={`section-head reveal ${align === 'center' ? 'mx-auto text-center' : ''}`}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="section-title" data-scramble-title aria-label={title}><span aria-hidden="true">{title}</span></h2>
  {lead && <p class="lead muted">{lead}</p>}
  <slot />
</header>
