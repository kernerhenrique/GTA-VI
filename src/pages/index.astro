---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Hub from '../components/sections/Hub.astro';
import NewsMarquee from '../components/sections/NewsMarquee.astro';
import ExploreGrid from '../components/sections/ExploreGrid.astro';
import SupportBand from '../components/support/SupportBand.astro';
import { videoGameJsonLd } from '../lib/seo';

const site = Astro.site!;
const webSite = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Leonida BR', inLanguage: 'pt-BR', url: new URL('/', site).href };
---
<Base
  title="GTA VI: contagem regressiva, preços no Brasil, personagens e Leonida | Leonida BR"
  description="Fan site brasileiro de GTA VI: contagem para 19/11/2026 (0h de Brasília), edições e preços em R$, personagens, mapa de Leonida, trailers, linha do tempo, notas da crítica e FAQ — tudo com fontes."
  jsonLd={[videoGameJsonLd(site), webSite]}
>
  <Hero />
  <Hub />
  <NewsMarquee />
  <ExploreGrid />
  <SupportBand />
</Base>
